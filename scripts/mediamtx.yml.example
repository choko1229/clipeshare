# MediaMTX設定テンプレート(clipshareライブ配信機能用)
#
# 使い方: /opt/mediamtx/mediamtx.yml としてコピーし、以下のプレースホルダーを実際の値に置き換える。
#   __LIVE_MEDIA_HOOK_SECRET__ : Next.js側の LIVE_MEDIA_HOOK_SECRET と同じ値
#   __APP_URL__                : 同一サーバー上のNext.jsへ直接届けるため http://127.0.0.1:3000 を推奨
#                                 (公開ドメイン経由にするとNginx/DNS/TLSに不要に依存するため)
#
# 詳細な導入手順は docs/vps-deployment.md の「ライブ配信機能の有効化」を参照。

logLevel: info
api: yes
apiAddress: 127.0.0.1:9997

# publish(配信開始)の認証はMediaMTX組み込みのHTTP認証を使う。
# authHTTPAddressはカスタムヘッダーを付けられないため、共有シークレットはクエリ文字列で渡す。
# app/api/live/hooks/auth/route.ts 側でこの値を検証する。publish以外のaction(read/api等)は
# そちら側で無条件に許可しているので、view-relayパスの読み取りやMediaMTX自身のControl API
# 呼び出しがブロックされることはない。
authMethod: http
authHTTPAddress: __APP_URL__/api/live/hooks/auth?secret=__LIVE_MEDIA_HOOK_SECRET__

rtmp: yes
rtmpAddress: :1935

# Web視聴(HLS)、VRChat向けMPEG-TS配信をこのHTTPサーバーで提供する。
# NginxからHTTPSでリバースプロキシする(直接インターネットに公開しない)。
hls: yes
hlsAddress: 127.0.0.1:8888
hlsAllowOrigins: ["*"]
# Low-Latency HLSはhlsSegmentCountが7未満だとmuxerが作成直後に自壊する
# ("Low-Latency HLS requires at least 7 segments")ため7を下限にする。
# セグメント1秒/パート200msは低遅延だがライブエッジの余裕が薄く、わずかな配信/回線の
# 揺らぎでもすぐバッファ枯渇してカクつく原因になっていたため、セグメント2秒/パート500msに
# 緩めてDVRウィンドウ(hlsSegmentCount×hlsSegmentDuration=14秒)を広げ安定性を優先する。
# OBS側のキーフレーム間隔もこの値(2秒)に合わせること(ズレるとセグメント境界が乱れる)。
hlsVariant: lowLatency
hlsSegmentCount: 7
hlsSegmentDuration: 2s
hlsPartDuration: 500ms

rtsp: yes
rtspAddress: :8554
rtspTransports: [tcp]

# WebRTC/SRTはclipshareのライブ機能では使わない(RTMP入稿・HLS/RTSP出力のみで完結する)。
# 明示的にoffにしないとMediaMTXは既定で両方ともポートを開けてしまう
# (webrtc: 8189/UDP・TCP, 8889/HTTP、srt: 8890/UDP)ため、未使用の待受ポートを閉じておく。
webrtc: no
srt: no

# すべてのパス(事前定義していないパスも含む)に共通で適用される設定。
# OBSからの入稿パス(live/{streamKey})はここに書かれた設定を自動的に継承して動的に作られるので、
# 個々のストリームキーごとにpathsへ明示的なエントリを用意する必要はない。
# runOnOfflineは「配信ソースがオンラインでなくなった」時に発火する切断通知フック。
# ここでは即座にOFFLINEへは倒さず、Next.js側でdisconnectedAtを記録するだけに留め、
# 実際のOFFLINE確定はscripts/live-chat-server.mjsの定期スイープ(猶予時間経過後)に任せる。
pathDefaults:
  runOnOffline: >
    curl -s -o /dev/null -X POST __APP_URL__/api/live/hooks/publish-end
    -H 'content-type: application/json'
    -H 'x-live-hook-secret: __LIVE_MEDIA_HOOK_SECRET__'
    -d '{"path":"$MTX_PATH"}'

# MediaMTXは既定で「設定されていないパス名」への配信・読み取りを一切許可しない。
# all_othersは「他のどのpathsエントリにもマッチしなかったパス」に対する特別な予約キーで、
# これが無いと live/{streamKey} のような動的な名前は 'is not configured' で即座に拒否される。
# 視聴用パス(live/{viewToken})はNext.js側のwebhookが
# POST /v3/config/paths/add/live/{viewToken} で動的に追加・削除する(lib/live/media-control.ts参照)が、
# それらもここを経由せず追加された時点でpathDefaultsを継承するので、個別定義は不要。
paths:
  all_others: {}

# VRChat Quest等スタンドアロン向けの低ビットレートMPEG-TS出力(video 2Mbps / audio 320kbps程度が目安、
# lib/live/settings.tsのデフォルト値と合わせる)は、MediaMTX本体ではなく別プロセス
# scripts/live-mpegts-relay.mjs (systemdサービス clipeshare-live-mpegts) が担当する。
# このプロセスがここで登録済みの視聴用パス(live/{viewToken}、上のRTSP出力と同じソース)を
# rtsp://127.0.0.1:8554/live/{viewToken} でpullし、ffmpegで再エンコードしてHTTP経由の
# 生MPEG-TSとしてクライアントへ配信する(Nginxの/ts/でリバースプロキシ、docs/vps-deployment.md参照)。
